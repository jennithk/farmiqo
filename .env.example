# Copy to .env for local development (never commit .env). Production secrets
# belong in the cloud host's secret manager, never in this file or in VITE_* vars.
VITE_APP_NAME=Farmiqo
VITE_APP_DESCRIPTION=Farmer to Consumer marketplace
VITE_APP_THEME=#2f8733
# Atlas replica-set URI (transactions required). Format only — no real credential here.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
# Server-only. Minimum 32 chars; generate with: npm run setup:local
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
API_PORT=3000
# Local browser origin for CORS. In production set to the public frontend origin(s).
APP_ORIGIN=http://localhost:5173
DELIVERY_FEE=0
# Same-origin API in production (/api). Native builds override at build time with
# VITE_API_URL=<public-https-origin>/api (must be https, never localhost).
VITE_API_URL=/api
# Optional integrations (leave unset to keep the features honestly disabled):
# Password-reset mail via Brevo HTTPS API (Railway free tier blocks SMTP).
# MAILER_PROVIDER=test is honored only when NODE_ENV=test (automated tests).
# BREVO_API_KEY=<brevo-api-key>
# RESET_FROM_EMAIL=<sender-email>
# RESET_FROM_NAME=Farmiqo
# APP_PUBLIC_URL=https://<public-frontend-origin>
# Product-photo uploads via Cloudinary signed uploads (free tier, no card).
# CLOUDINARY_CLOUD_NAME=<cloud-name>
# CLOUDINARY_API_KEY=<api-key>
# CLOUDINARY_API_SECRET=<api-secret>
