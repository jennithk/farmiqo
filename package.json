{
  "name": "farmiqo-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "setup:local": "node scripts/setup-local.js",
    "api": "node backend/server.js",
    "ui": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "check": "node --check app.js && node --check backend/server.js && node --check services/api.js && node --check services/icons.js && node --check i18n/en.js && node --check i18n/te.js && vite build",
    "test": "node --test \"tests/**/*.mjs\"",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "pwa": "vite build",
    "cap:sync": "npx cap sync",
    "android": "npx cap open android",
    "android:debug": "cd android && gradlew.bat assembleDebug",
    "android:install": "cd android && gradlew.bat installDebug",
    "android:release": "cd android && gradlew.bat assembleRelease",
    "android:aab": "cd android && gradlew.bat bundleRelease",
    "ios:sync": "npx cap sync ios",
    "ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^7.6.9",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "lucide": "^1.53.0",
    "mongoose": "^9.11.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/ios": "^7.6.9",
    "mongodb-memory-server": "^11.3.0",
    "vite": "^6.4.4"
  }
}
